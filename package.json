{
  "name": "work-life-hub",
  "version": "0.1.0",
  "private": false,
  "description": "A privacy-first work and life dashboard powered by local IndexedDB storage.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:stage1": "node --experimental-strip-types --test tests/stage1-project.test.ts",
    "test:stage2": "node --experimental-strip-types --test tests/stage2-local-storage.test.ts",
    "test:stage3": "node --experimental-strip-types --test tests/stage3-domain.test.ts",
    "test:stage4": "node --experimental-strip-types --test tests/stage4-app.test.ts",
    "test:stage5": "node --experimental-strip-types --test tests/stage5-backup.test.ts",
    "mobile:build": "npm run build",
    "mobile:sync": "npx cap sync",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
